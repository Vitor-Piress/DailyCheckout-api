{
  "name": "dailycheckout-api",
  "version": "1.0.0",
  "description": "API do DailyCheckout",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc --noEmit false",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "start:prod": "npm run build && npm start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "users:link": "tsx scripts/link-user.ts"
  },
  "keywords": [
    "dailycheckout",
    "api",
    "fastify"
  ],
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
